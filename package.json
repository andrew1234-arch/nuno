{
  "name": "nuno",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b && pnpm --filter @nuno/web exec tsc --noEmit",
    "lint": "eslint .",
    "deploy:contracts": "cd contracts && set -a && . ../.env && set +a && forge script script/Deploy.s.sol --rpc-url $MONAD_TESTNET_RPC_URL --broadcast",
    "contracts:test": "cd contracts && forge test",
    "contracts:abi": "cd contracts && forge build && cd .. && node scripts/export-abi.mjs",
    "publish:snapshots": "pnpm --filter @nuno/publisher publish-snapshots",
    "web": "pnpm --filter @nuno/web dev",
    "infra:scan": "pnpm --filter @nuno/metrics infra-scan",
    "backfill:local": "pnpm --filter @nuno/pipeline backfill",
    "storage:report": "pnpm --filter @nuno/metrics storage-report",
    "tick": "pnpm --filter @nuno/pipeline tick",
    "recluster": "pnpm --filter @nuno/pipeline recluster",
    "export:static": "pnpm --filter @nuno/pipeline export-static",
    "web:build": "pnpm --filter @nuno/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
