{
  // Nuno: REST API + Cron Triggers on Cloudflare Workers (SPEC §7.10). Workers Paid plan required.
  "name": "nuno",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuno",
      // Set after `wrangler d1 create nuno` (see README). Placeholder until the user's account is linked.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/shared/migrations"
    }
  ],
  "triggers": {
    // tick (tail -> funding -> incremental metrics -> publish), hourly storage check, daily prune
    "crons": ["* * * * *", "7 * * * *", "30 3 * * *"]
  },
  "vars": {
    "MONAD_MAINNET_RPC_URL": "https://rpc1.monad.xyz",
    "MONAD_MAINNET_LOGS_RPC_URLS": "https://rpc1.monad.xyz,https://rpc-mainnet.monadinfra.com,https://rpc.monad.xyz",
    "MONAD_MAINNET_LOGS_RANGE": "100",
    "MONAD_TESTNET_RPC_URL": "https://testnet-rpc.monad.xyz",
    "PUBLISH_CHAIN_ID": "10143",
    "NUNO_FEED_ADDRESS": "",
    "BACKFILL_DAYS": "7",
    "MIN_BUYERS": "20",
    "STORAGE_TARGET_BYTES": "1500000000",
    "STORAGE_ALARM_BYTES": "2500000000",
    "STORAGE_HARD_STOP_BYTES": "3000000000"
  }
  // Secret (not in this file): `wrangler secret put PUBLISHER_PRIVATE_KEY`
}
