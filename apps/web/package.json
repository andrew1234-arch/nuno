{
  "name": "@nuno/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/embed-methodology.mjs && next dev -p 3000",
    "build": "node scripts/embed-methodology.mjs && next build",
    "start": "next start -p 3000",
    "cf:build": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build",
    "cf:preview": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "marked": "^15.0.4",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.149.0"
  }
}
